%% Ownership: each of the 5 required runtime services gets one
%% independent instance per node - no single global owner.
graph TB
    subgraph Node0["Node 0"]
        MM0["Memory Manager #0"]
        SC0["Scheduler #0"]
        CM0["Capability Manager #0"]
        RG0["Registry #0"]
        TM0["Timers #0"]
    end

    subgraph Node1["Node 1"]
        MM1["Memory Manager #1"]
        SC1["Scheduler #1"]
        CM1["Capability Manager #1"]
        RG1["Registry #1"]
        TM1["Timers #1"]
    end

    subgraph NodeN["Node N"]
        MMN["Memory Manager #N"]
        SCN["Scheduler #N"]
        CMN["Capability Manager #N"]
        RGN["Registry #N"]
        TMN["Timers #N"]
    end

    Router["router.homeNodeFor(key, node_count)\nstateless, coordination-free"]

    Router -. "routes key K" .-> MM0
    Router -. "routes key K'" .-> RG1
    Router -. "routes key K''" .-> TMN

    style Router fill:#f9f,stroke:#333
